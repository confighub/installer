--- out/.gitignore
# Rendered secrets must never be committed.
secrets/
--- out/compose/installer-transformer.sh
#!/bin/sh
INSTALLER_RUN_TRANSFORMER=1 exec "$EXE"
--- out/compose/kustomization.yaml
# Reproduce this render with:
#   kustomize build --enable-exec --enable-alpha-plugins .
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
    - ../../package/bases/default
components:
    - ../../package/components/monitoring
transformers:
    - transformers.yaml
--- out/compose/transformers.yaml
apiVersion: installer.confighub.com/v1alpha1
kind: ConfigHubTransformers
metadata:
    name: hello-app-transformers
    annotations:
        config.kubernetes.io/function: |
            exec:
              path: ./installer-transformer.sh
spec:
    namespace: demo
    groups:
        - toolchain: Kubernetes/YAML
          invocations:
            - name: set-namespace
              args:
                - demo
          description: Set the namespace on every namespaced resource.
--- out/manifests/deployment-demo-hello-app.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app: hello-app
  name: hello-app
  namespace: demo
spec:
  replicas: 1
  selector:
    matchLabels:
      app: hello-app
  template:
    metadata:
      labels:
        app: hello-app
    spec:
      containers:
        - image: nginxdemos/hello:plain-text
          name: app
          ports:
            - containerPort: 80
              name: http
--- out/manifests/namespace-demo.yaml
apiVersion: v1
kind: Namespace
metadata:
  name: demo
--- out/manifests/service-demo-hello-app.yaml
apiVersion: v1
kind: Service
metadata:
  labels:
    app: hello-app
  name: hello-app
  namespace: demo
spec:
  ports:
    - name: http
      port: 80
      targetPort: http
  selector:
    app: hello-app
--- out/manifests/servicemonitor-demo-hello-app.yaml
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  labels:
    app: hello-app
  name: hello-app
  namespace: demo
spec:
  endpoints:
    - interval: 30s
      port: http
  selector:
    matchLabels:
      app: hello-app
--- out/record/function-chain.yaml
apiVersion: installer.confighub.com/v1alpha1
kind: FunctionChain
metadata:
  name: hello-app-function-chain
spec:
  package: hello-app
  packageVersion: 0.1.0
  groups:
    - toolchain: Kubernetes/YAML
      invocations:
        - name: set-namespace
          args:
            - demo
      description: Set the namespace on every namespaced resource.
--- out/record/inputs.yaml
apiVersion: installer.confighub.com/v1alpha1
kind: Inputs
metadata:
  name: hello-app-inputs
spec:
  package: hello-app
  packageVersion: 0.1.0
  namespace: demo
  values:
    team: platform
--- out/record/manifest-index.yaml
apiVersion: installer.confighub.com/v1alpha1
kind: ManifestIndex
metadata:
  name: hello-app-manifest-index
spec:
  package: hello-app
  packageVersion: 0.1.0
  files:
    - filename: deployment-demo-hello-app.yaml
      slug: deployment-demo-hello-app
      apiVersion: apps/v1
      kind: Deployment
      name: hello-app
      namespace: demo
    - filename: namespace-demo.yaml
      slug: namespace-demo
      apiVersion: v1
      kind: Namespace
      name: demo
    - filename: service-demo-hello-app.yaml
      slug: service-demo-hello-app
      apiVersion: v1
      kind: Service
      name: hello-app
      namespace: demo
    - filename: servicemonitor-demo-hello-app.yaml
      slug: servicemonitor-demo-hello-app
      apiVersion: monitoring.coreos.com/v1
      kind: ServiceMonitor
      name: hello-app
      namespace: demo
--- out/record/selection.yaml
apiVersion: installer.confighub.com/v1alpha1
kind: Selection
metadata:
  name: hello-app-selection
spec:
  package: hello-app
  packageVersion: 0.1.0
  base: default
  components:
    - monitoring
--- out/record/source.yaml
apiVersion: installer.confighub.com/v1alpha1
kind: Source
metadata:
  name: hello-app-source
spec:
  ref: $PKG_V1
