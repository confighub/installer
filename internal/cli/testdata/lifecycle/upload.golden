    "ChangeSetDescription": "installer upload of hello-app@v0.1.0",
    "Components": [
      {
        "Name": "hello-app",
        "Namespace": "demo",
        "SourceName": "hello-app",
        "Space": "hello",
        "SpaceLabels": {
          "Component": "hello-app",
          "Variant": "base"
        }
      }
    ],
    "DryRun": true,
    "Files": [
      {
        "Content": "sha256:0273cdf3342790e0",
        "Path": "manifests/deployment-demo-hello-app.yaml"
      },
      {
        "Content": "sha256:2bc57b77bfefcea4",
        "Path": "manifests/namespace-demo.yaml"
      },
      {
        "Content": "sha256:a06d27b8e5ee41bc",
        "Path": "manifests/service-demo-hello-app.yaml"
      },
